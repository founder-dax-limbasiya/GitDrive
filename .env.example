# Canonical GitDrive GitHub OAuth callback
GITHUB_APP_REDIRECT_URI=https://gitdrive-omega.vercel.app/api/auth/github/callback

# Generate a random secret with at least 32 characters.
GITDRIVE_SESSION_PASSWORD=replace_with_a_random_secret_at_least_32_chars

# GitHub App Client ID and Client Secret are issued during the guided
# GitHub App Manifest setup and stored in the encrypted HttpOnly session
# for the current personal beta browser. They are not committed here.
